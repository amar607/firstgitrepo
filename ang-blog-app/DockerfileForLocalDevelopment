FROM node:20.19.4

WORKDIR /app

COPY package*.json ./
RUN npm install -g @angular/cli@16.2.12 && npm install

COPY . .

EXPOSE 4200

CMD ["ng", "serve", "--host", "0.0.0.0", "--port", "4200"]



